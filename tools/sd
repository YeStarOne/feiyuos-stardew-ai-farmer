def _norm_path(a):
    """把用户给的端点名归一成 /x/y。

    Git Bash（MSYS）会把**以 / 开头的参数**当 Windows 路径改写：
        /state      -> D:/Program Files/Git/state
        /inv/count  -> D:/Program Files/Git/inv/count
    2026-11-08 实测踩到：`sd wait /state ...` 发出去的是 "D:/Program Files/Git/state"，
    服务端回 path_not_waitable。这不是服务端的错，也不是引号的问题，是 shell 改写了参数。
    所以这里既接受 'state' / '/state'，也能从被改写的串里把尾巴捞回来。
    """
    s = str(a or '').replace(chr(92), '/')   # 反斜杠先统一成斜杠，下面只处理斜杠
    if '/Git/' in s:                      # MSYS 根目录下的改写
        s = s.split('/Git/', 1)[1]
    elif len(s) > 1 and s[1] == ':' and '/' in s:
        s = s.split(':', 1)[1].lstrip('/')
    if not s.startswith('/'):
        s = '/' + s
    return s


def cmd_wait(args):
    """等一个条件成立。退出码就是结果：0 matched / 2 timeout / 3 degraded / 1 其它。

    这是替代 `for i in $(seq 1 40); do sleep 15; curl /state; done` 的那一行。
    阻塞一次，服务端 1s 采样一次 /state，命中立刻返回。
    """
    if len(args) < 2:
        die("用法: sd wait <path> <condition> [秒] [--json]")
    path, cond = _norm_path(args[0]), args[1]
    rest = [a for a in args[2:] if a != "--json"]
    as_json = "--json" in args[2:]
    tmo = int(rest[0]) if rest and rest[0].isdigit() else 60
    if tmo > 300:
        tmo = 300
    body = {"path": path, "condition": cond, "timeout_s": tmo}
    raw = _curl(WAIT_URL, data=body, timeout=tmo + 15)
    if not raw:
        die("wait 服务没回话（%s）—— 看 feiyu-wait 是否在跑" % WAIT_URL)
    try:
        d = json.loads(raw)
    except ValueError:
        die("wait 返回的不是 JSON: %s" % raw[:120])
    if as_json:
        print(json.dumps(d, ensure_ascii=False))
    else:
        r = d.get("reason")
        if r == "matched":
            print("MATCHED  %s  (样本%d, %dms)" % (cond, d.get("samples_ok", 0), d.get("elapsed_ms", 0)))
        elif r == "timeout":
            print("TIMEOUT  %s  %ss 内没成立 (样本%d)"
                  % (cond, d.get("effective_timeout_s"), d.get("samples_ok", 0)))
        elif r == "degraded":
            print("DEGRADED 看不见状态，不是条件不成立：失败 %d/%d 样本"
                  % (d.get("samples_failed", 0), d.get("samples_total", 0)))
        else:
            print("ERR %s: %s" % (r, d.get("detail") or ""))
        if d.get("samples_missing"):
            if path.startswith("/inv/count"):
                tip = "物品名用下划线小写（如 parsnip_seeds、quality_sprinkler）"
            else:
                tip = "字段名可能写错，真名用 `sd state --json` 看（钱在 player.money，不是 money）"
            print("  提示: missing=%d —— %s" % (d["samples_missing"], tip))
    sys.exit({"matched": 0, "timeout": 2, "degraded": 3}.get(d.get("reason"), 1))


def cmd_raw(args):
    if not args:
        die("用法: sd raw <endpoint> [json]")
    ep = args[0] if args[0].startswith("/") else "/" + args[0]
    if len(args) > 1:
        d = _post(ep.lstrip("/"), json.loads(args[1]), timeout=25)
    else:
        d = _get(ep, timeout=25)
    out = json.dumps(d, ensure_ascii=False)
    # 绝不截半截 JSON（11-13）：以前这里写 [:1500]，超长时切在字符串中间，
    # 吐出来的是**非法 JSON**。她后面接 `| python3 -c "json.load(sys.stdin)"`
    # 必炸——实测 31 次 /state 调用里 6 次报 Traceback（19.4%），而端点本身
    # 一次没坏（直连 47843 返回 13036 字节合法 JSON）。这是工具层造假失败。
    #
    # 修法：超长时折叠**大字段**而不是切字符。折叠顺序=列表先折、同类别内大的
    # 先折；实测 /state 里 inventory 一个字段就占 9044/12387 字（73%），只折它
    # 和 recent_events 就够，player/time/location 永远活下来（那是她最常读的）。
    #
    # 预算 2500 而不是 1500：player 单字段就 1288 字，1500 装不下
    # player+time+location，会把 player 折成字符串 → `d["player"]["money"]`
    # 立刻 KeyError，等于把工具修坏。2500 字≈700 token，比 12387 字省 80%。
    # 永不折叠的字段：她真的会读这些。player 单字段 1288 字，按纯体积排序
    # 会先折它（列表折完还不够时），结果 `d["player"]["money"]` 直接 KeyError。
    # 体积排序只能用来决定「先折谁」，不能决定「能不能折谁」。
    CORE = {"ok", "worldReady", "player", "time", "location", "activeMenu",
            "activeEvent", "in_dialogue"}
    BUDGET = 3000
    if len(out) > BUDGET:
        if isinstance(d, dict):
            keep = dict(d)
            def _fold_rank(item):
                n, k = item
                return (0 if isinstance(d[k], (list, tuple)) else 1, -n)
            sized = sorted(((len(json.dumps(v, ensure_ascii=False)), k)
                            for k, v in d.items()), key=_fold_rank)
            folded = []
            for n, k in sized:
                if len(json.dumps(keep, ensure_ascii=False)) <= BUDGET:
                    break
                if k in CORE:
                    continue          # 核心字段：宁可超预算也不折
                v = d[k]
                if isinstance(v, (list, tuple)):
                    keep[k] = {"_count": len(v), "_folded": True,
                               "_sample": str(list(v[:1]))[:160]}
                else:
                    keep[k] = {"_chars": n, "_folded": True}
                folded.append(k)
            keep["_folded"] = folded
            out = json.dumps(keep, ensure_ascii=False)
        else:
            out = json.dumps({"_truncated": True, "_total_chars": len(out)},
                             ensure_ascii=False)
    print(out)


def cmd_farm(args):
    """sd farm <子命令> —— 一天的农活一口气跑完

    子命令:
      scan [x1 y1 x2 y2]   扫一次田，打印 该浇/该收/该清 三个数（默认 50 14 68 28）
      water [x1 y1 x2 y2]  先 refill 再整片浇，最后重扫复核
      reap  [x1 y1 x2 y2]  先站到田中心再 /harvest，打印实际收了几株
      day                  打死一整套：scan -> refill -> water -> reap -> 复核
      clean                列出枯萎作物坐标（只读，不改）
      dig x1 y1 x2 y2      把矩形内所有"能耕且空着"的格子翻成 HoeDirt

    为什么要有它：/tool_area 会独占游戏主线程最长 10 分钟，/queue 又会抢走它的
    等待句柄（实测并发时 tool_area 返回 0 字节）。所以这一层必须自己管顺序、
    自己复核，不能让她手搓 curl 并发。
    """
    P = os.environ.get("SD_FARM_RECT", "50 14 68 28").split()
    sub = args[0] if args else "day"
    rest = args[1:]

    def rect():
        if len(rest) >= 4:
            return [int(v) for v in rest[:4]]
        return [int(v) for v in P]

    def scan_tiles(x1, y1, x2, y2):
        # 必须先确认人在 Farm：室内时 /surroundings 会把矩形静默夹成 11x11
        st = _get("/state")
        loc = (st.get("location") or {}).get("name")
        if loc != "Farm":
            die("人不在 Farm（在 %s）—— 先 `sd warp Farm 64 17`，否则扫出来是空的" % loc)
        d = _get("/surroundings?x1=%d&y1=%d&x2=%d&y2=%d" % (x1, y1, x2, y2), timeout=25)
        sc = d.get("scanned") or {}
        # 被夹范围的检测：请求的矩形必须原样回来
        if (sc.get("x1"), sc.get("y1"), sc.get("x2"), sc.get("y2")) != (x1, y1, x2, y2):
            die("矩形被桥夹了：请求(%d,%d)-(%d,%d) 实得%s —— 人可能在室内"
                % (x1, y1, x2, y2, json.dumps(sc)))
        return d.get("tiles") or []

    def tally(tiles):
        crops = [t for t in tiles if t.get("crop")]
        ripe = [t for t in crops if t.get("harvestable")]
        dry = [t for t in crops if not t.get("watered") and not t.get("harvestable")]
        open_ = [t for t in tiles
                 if t.get("diggable") and not t.get("terrain") and not t.get("object")]
        return crops, ripe, dry, open_

    if sub == "scan" or sub == "clean":
        x1, y1, x2, y2 = rect()
        crops, ripe, dry, open_ = tally(scan_tiles(x1, y1, x2, y2))
        if sub == "clean":
            # 桥没有"枯萎"概念，只能靠外部特征猜：有 crop、不在成熟、且 cropPhase 停在
            # 某值很多天。这里只列"有作物但永远不熟"的候选，绝不替她判定死活。
            print("候选（有作物但未熟）%d 株 —— 我判断不了死活，你看画面" % len(crops))
            for t in crops:
                print("  (%d,%d) %s phase=%s watered=%s"
                      % (t["x"], t["y"], t.get("cropName"), t.get("cropPhase"), t.get("watered")))
            return
        print("田 (%d,%d)-(%d,%d) | 作物 %d | 熟 %d | 该浇 %d | 可开垦 %d"
              % (x1, y1, x2, y2, len(crops), len(ripe), len(dry), len(open_)))
        return

    if sub == "water":
        x1, y1, x2, y2 = rect()
        # 1) 先 refill：壶空时 /tool_area 只跑 1 格就停，而 ok 还是 true
        r = _post("refill", {})
        if not r.get("ok", True) and "No watering can" in str(r.get("error", "")):
            die("包里没有水壶")
        print("水壶 %s/%s" % (r.get("water"), r.get("max")))
        # 2) 整片浇。这一步独占主线程，期间不许发任何别的请求
        body = {"operation": "water", "x1": x1, "y1": y1, "x2": x2, "y2": y2}
        d = _post("tool_area", body, timeout=600)
        if d.get("out_of_water"):
            print("⚠️ 中途壶空了（out_of_water）—— 再跑一次 `sd farm water`")
        print("浇：swings=%s still_missing=%s executed=%s"
              % (d.get("swings"), len(d.get("still_missing") or []),
                 (d.get("result") or {}).get("executed")))
        # 3) 复核：不重扫一次不算数
        crops, ripe, dry, open_ = tally(scan_tiles(x1, y1, x2, y2))
        print("复核：作物 %d | 还干着 %d" % (len(crops), len(dry)))
        if dry:
            print("  还干的坐标：" + " ".join("(%d,%d)" % (t["x"], t["y"]) for t in dry[:20]))
        return

    if sub == "reap":
        x1, y1, x2, y2 = rect()
        crops, ripe, dry, open_ = tally(scan_tiles(x1, y1, x2, y2))
        if not ripe:
            print("没有成熟的（作物 %d 株，熟 0）—— 不白跑" % len(crops))
            return
        # /harvest 不走路，按玩家脚下算半径。先站到成熟作物群的几何中心
        cx = int(sum(t["x"] for t in ripe) / len(ripe))
        cy = int(sum(t["y"] for t in ripe) / len(ripe))
        w = _post("warp", {"location": "Farm", "x": cx, "y": cy})
        if not w.get("ok", True):
            # 中心格站不住时用桥建议的落脚点
            near = (w.get("standable_near") or [])
            if not near:
                die("站不到 (%d,%d) 也没有可站的邻居" % (cx, cy))
            w = _post("warp", {"location": "Farm",
                               "x": near[0]["x"], "y": near[0]["y"]})
        for _ in range(20):
            st = _get("/state")
            if (st.get("location") or {}).get("name") == "Farm":
                break
            time.sleep(0.3)
        span = max(max(t["x"] for t in ripe) - min(t["x"] for t in ripe),
                   max(t["y"] for t in ripe) - min(t["y"] for t in ripe)) // 2 + 2
        h = _post("harvest?radius=%d" % min(span, 50), {})
        print("收：harvested=%s（半径 %d）" % (h.get("harvested"), min(span, 50)))
        crops2, ripe2, _, _ = tally(scan_tiles(x1, y1, x2, y2))
        print("复核：还剩熟 %d 株，作物总数 %d" % (len(ripe2), len(crops2)))
        return

    if sub == "dig":
        x1, y1, x2, y2 = rect()
        tiles = scan_tiles(x1, y1, x2, y2)
        _, _, _, open_ = tally(tiles)
        if not open_:
            print("矩形内没有可开垦的空地")
            return
        # /till_area 只认 tiles[]，传 x1..y2 会被静默忽略并退化成"面朝格"
        before_tilled = {(t["x"], t["y"]) for t in open_ if t.get("terrain") == "HoeDirt"}
        body = {"tiles": [{"x": t["x"], "y": t["y"]} for t in open_]}
        d = _post("till_area", body, timeout=120)
        print("翻地：桥报 tilled=%s skipped=%s（这是它处理了几格，不是新增几格）"
              % (d.get("tilled_count"), d.get("skipped_count")))
        for s in (d.get("skipped") or [])[:8]:
            print("  跳过 (%s,%s) %s" % (s.get("x"), s.get("y"), s.get("reason")))
        # 复核：翻前翻后各数一遍"该翻的格里有多少已经是 HoeDirt"，差值才叫真新增
        want = {(t["x"], t["y"]) for t in open_}
        now = {(t["x"], t["y"]) for t in scan_tiles(x1, y1, x2, y2)
               if t.get("terrain") == "HoeDirt"}
        print("复核：这 %d 格里现在有 %d 格是 HoeDirt（本次新翻 %d）"
              % (len(want), len(want & now), len(want - before_tilled)))
        miss = want - now
        if miss:
            print("  还是没翻的：" + " ".join("(%d,%d)" % p for p in sorted(miss)))
        return

    if sub == "day":
        x1, y1, x2, y2 = rect()
        crops, ripe, dry, open_ = tally(scan_tiles(x1, y1, x2, y2))
        st = _get("/state")
        tod = int((st.get("time") or {}).get("timeOfDay") or 0)
        print("== 夏%d %02d:%02d | 作物 %d 熟 %d 该浇 %d 可开垦 %d"
              % ((st.get("time") or {}).get("dayOfMonth") or 0, tod // 100, tod % 100,
                 len(crops), len(ripe), len(dry), len(open_)))
        if ripe:
            print("-- 1/3 收")
            cmd_farm(["reap"] + [str(v) for v in (x1, y1, x2, y2)])
        if dry:
            print("-- 2/3 浇")
            cmd_farm(["water"] + [str(v) for v in (x1, y1, x2, y2)])
        else:
            print("-- 2/3 浇：今天不用浇（没干的）")
        print("-- 3/3 完；扩田要手动 `sd farm dig x1 y1 x2 y2`（怕把你计划外的地也翻了）")
        return

    die("sd farm 只认: scan|clean|water|reap|dig|day")


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip().split("\n\n")[-2])
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    try:
        if cmd == "state":
            cmd_state(args)
        elif cmd == "inv":
            cmd_inv(args)
        elif cmd == "near":
            cmd_near(args)
        elif cmd == "shot":
            cmd_shot(args)
        elif cmd in ACTIONS:
            cmd_action(cmd, args)
        elif cmd == "wait":
            cmd_wait(args)
        elif cmd == "raw":
            cmd_raw(args)
        elif cmd == "farm":
            cmd_farm(args)
        else:
            die("不认识: %s（sd help 看用法）" % cmd)
    except (KeyboardInterrupt, BrokenPipeError):
        pass
    except Exception as e:  # noqa: BLE001 - 失败必须以一行报出去
        die("%s: %s" % (type(e).__name__, str(e)[:120]))


if __name__ == "__main__":
    main()
