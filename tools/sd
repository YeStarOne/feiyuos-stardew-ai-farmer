def _curl(url, data=None, timeout=TIMEOUT):
    # subprocess 调 curl：服务器上 python 的 urllib 直连桥会 ConnectionReset
    # 2026-11-11: 她自己的桥(47843)按 Host 白名单放行，缺头一律 400 Bad Request
    cmd = ["curl", "-s", "-m", str(int(timeout)), "-H", "Host: localhost"]
    if data is not None:
        cmd += ["-X", "POST", "-H", "Content-Type: application/json", "-d", json.dumps(data)]
    cmd += [url]
    for _ in range(2):
        p = subprocess.run(cmd, capture_output=True)
        out = p.stdout.decode("utf-8", "replace").strip()
        if out and p.returncode == 0:
            return out
    return ""


def _get(endpoint, timeout=TIMEOUT):
    raw = _curl(BRIDGE + endpoint, timeout=timeout)
    if not raw:
        die("桥没回话（%s）—— 看 PC 是否开机/游戏是否在跑" % endpoint)
    try:
        return json.loads(raw)
    except ValueError:
        die("桥返回的不是 JSON（%s）：%s" % (endpoint, raw[:120]))


def _post(endpoint, body, timeout=TIMEOUT):
    raw = _curl(BRIDGE + "/" + endpoint, data=body or {}, timeout=timeout)
    if not raw:
        die("桥没回话（%s）" % endpoint)
    try:
        return json.loads(raw)
    except ValueError:
        return {"ok": True, "raw": raw[:200]}


