def _clock(t):
    tod = int(t.get("timeOfDay", 0))
    return "%02d:%02d" % (tod // 100, tod % 100)


def _where(d):
    loc = (d.get("location") or {}).get("name", "?")
    p = d.get("player") or {}
    return "%s(%s,%s)" % (loc, p.get("x"), p.get("y"))


def _vitals(d):
    p = d.get("player") or {}
    return "体力%d/%d HP%d" % (int(p.get("stamina", 0)), int(p.get("maxStamina", 0)), int(p.get("health", 0)))


